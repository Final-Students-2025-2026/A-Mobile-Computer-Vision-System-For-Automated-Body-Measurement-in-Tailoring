{
  "expo": {
    "name": "measure-ai",
    "slug": "measure-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/measure-ai-icon.png",
    "scheme": "measureai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "bundleIdentifier": "com.measureai.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.measureai.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/measure-ai-icon.png",
        "backgroundColor": "#C8F04A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Measure AI to use your camera for body measurement capture."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Measure AI to access your photos so you can add client profile photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/measure-ai-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#C8F04A",
          "dark": {
            "backgroundColor": "#1A1A1A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b5ec3b6-22c8-4007-9218-df3e6348ca91"
      }
    },
    "owner": "ruweida"
  }
}
